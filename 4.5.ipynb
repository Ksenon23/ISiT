   "outputs": [],
   "source": [
    "def get_marks(marks):\n",
    "    if len(marks) == 1:\n",
    "        return marks[0]\n",
    "    else:\n",
    "        return min(get_marks(marks[:-1]), marks[-1])"
   ]
  },
